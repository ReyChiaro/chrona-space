# 复制为 .env 后填写。服务端读取（浏览器永远拿不到这些值）。
# 详细说明见 docs/v1/RUNBOOK.md

# ---- 视频模型（服务器本地权重）----
CHRONA_VIDEO_ADAPTER=stub          # stub | h3
CHRONA_MODEL_PATH=/data/models/MiniMax-H3
CHRONA_LORA_DIR=/data/loras
CHRONA_DATA_DIR=/data/chrona

# ---- Code Agent（OpenAI 兼容，支持 tool calling）----
CHRONA_AGENT_BASE_URL=
CHRONA_AGENT_API_KEY=
CHRONA_AGENT_MODEL=

# ---- 提示词增强（独立 key）----
CHRONA_PROMPT_BASE_URL=
CHRONA_PROMPT_API_KEY=
CHRONA_PROMPT_MODEL=

# ---- 视频服务地址（浏览器侧用，默认即可）----
CHRONA_VIDEO_BASE_URL=http://127.0.0.1:8000
