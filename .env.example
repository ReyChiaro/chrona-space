# 凭据与外部服务地址。复制为 .env 后填写；.env 不入库。
# 说明：v1 只实现到"结构完整、无模型推理"，以下变量供接入真实服务时使用。

# Code Agent（OpenAI 兼容端点）
CHRONA_AGENT_BASE_URL=
CHRONA_AGENT_API_KEY=
CHRONA_AGENT_MODEL=

# 提示词增强（与 Code Agent 使用不同的 key）
CHRONA_PROMPT_BASE_URL=
CHRONA_PROMPT_API_KEY=

# 视频模型服务：本地部署时指向本机端口，不在这里放权重路径
CHRONA_VIDEO_BASE_URL=http://127.0.0.1:8000
